# Leave VITE_API_BASE_URL unset in dev so axios uses the Vite dev-server proxy
# (see vite.config.ts) — same-origin, no CORS. Override only for a different API.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Where Vite proxies /api and /sanctum (must match your running Laravel origin).
# Default is http://127.0.0.1:8000 (php artisan serve). For Valet/Herd, uncomment:
# VITE_DEV_BACKEND_URL=https://portfolio-tracker-v2.test
